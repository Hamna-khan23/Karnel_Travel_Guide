@model Karnel_Travel_Guide.Models.Restaurant

@{
    ViewData["Title"] = Model.Name;

    List<string> imageList = new List<string>();
    if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        imageList = Model.ImageUrl.Split(',', StringSplitOptions.RemoveEmptyEntries)
                                  .Select(img => img.Trim())
                                  .ToList();
    }
}

<div class="container-fluid py-5">
    <div class="container py-5">

        <div class="row g-5">
            <!-- Left Side: Image Gallery -->
            <div class="col-lg-7">
                @if (imageList.Any())
                {
                    <div id="restaurantImageCarousel" class="carousel slide shadow rounded overflow-hidden" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            @for (int i = 0; i < imageList.Count; i++)
                            {
                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                    <img src="@Url.Content(imageList[i])" class="d-block w-100" alt="@Model.Name" style="height: 420px; object-fit: cover;" />
                                </div>
                            }
                        </div>
                        @if (imageList.Count > 1)
                        {
                            <button class="carousel-control-prev" type="button" data-bs-target="#restaurantImageCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon"></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#restaurantImageCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon"></span>
                            </button>
                        }
                    </div>

                    <!-- Thumbnail Grid -->
                    @if (imageList.Count > 1)
                    {
                        <div class="row g-2 mt-2">
                            @for (int i = 0; i < imageList.Count; i++)
                            {
                                <div class="col-3">
                                    <img src="@Url.Content(imageList[i])" class="img-fluid rounded border" style="height: 80px; width: 100%; object-fit: cover; cursor: pointer;" onclick="$('#restaurantImageCarousel').carousel(@i)" />
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <img src="/images/default-restaurant.jpg" class="img-fluid rounded shadow w-100" style="height: 400px; object-fit: cover;" />
                }
            </div>

            <!-- Right Side: Restaurant Info -->
            <div class="col-lg-5">
                <div class="bg-light p-4 rounded shadow-sm">
                    <span class="badge bg-primary mb-2">@Model.City</span>
                    <h2 class="fw-bold mb-3">@Model.Name</h2>

                    <div class="d-flex align-items-center mb-3">
                        <span class="text-warning h5 mb-0 me-3">
                            <i class="fa fa-star"></i> @Model.Rating
                        </span>
                        <span class="text-muted"><i class="fa fa-utensils me-1"></i> @Model.Cuisine</span>
                    </div>

                    <h4 class="text-success fw-bold mb-4">Price Range: <span class="text-dark">@Model.PriceRange</span></h4>

                    <h5 class="fw-bold mb-2">Description</h5>
                    <p class="text-muted mb-4">@Model.Description</p>

                    <div class="mb-4">
                        <strong>Availability: </strong>
                        @if (Model.Availability)
                        {
                            <span class="badge bg-success">Open / Available</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Currently Closed</span>
                        }
                    </div>

                    <div class="d-grid gap-2">
                        @if (Model.Availability)
                        {
                            <a asp-controller="Bookings" asp-action="BookRestaurant" asp-route-id="@Model.RestaurantID" class="btn btn-primary btn-lg">
                                <i class="fa fa-calendar-check me-2"></i> Book Now
                            </a>
                        }
                        <a asp-controller="Restaurants" asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fa fa-arrow-left me-2"></i> Back to Restaurants
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>