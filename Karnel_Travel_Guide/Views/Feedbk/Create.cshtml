@model Karnel_Travel_Guide.Models.Feedback

@{
    ViewData["Title"] = "Feedback";
}

<div class="container-fluid py-5">
    <div class="container py-5">

        <!-- Page Heading -->
        <div class="text-center mb-5">
            <h5 class="text-primary text-uppercase">
                Feedback
            </h5>

            <h1 class="display-5">
                Share Your Experience
            </h1>

            <p class="text-muted">
                Tell us about your travel experience with
                Karnel Travel Guide.
            </p>
        </div>


        <!-- Feedback Form -->
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">

                <div class="bg-light rounded p-5 shadow-sm">

                    <!-- Success Message -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show"
                             role="alert">

                            <i class="fa fa-check-circle me-2"></i>

                            @TempData["SuccessMessage"]

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert">
                            </button>

                        </div>
                    }


                    <!-- Feedback Form -->
                    <form asp-controller="Feedbk"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()


                        @* <!-- Booking -->
                        <div class="mb-4">

                            <label asp-for="BookingID"
                                   class="form-label fw-bold">
                                Select Your Booking
                            </label>

                            <select asp-for="BookingID"
                                    asp-items="ViewBag.Bookings"
                                    class="form-select">

                                <option value="">
                                    -- Select Your Booking --
                                </option>

                            </select>

                            <span asp-validation-for="BookingID"
                                  class="text-danger">
                            </span>

                        </div> *@
                        <div class="mb-4">
                            <label asp-for="BookingID" class="form-label fw-bold">
                                Booking ID
                            </label>

                            <input asp-for="BookingID"
                                   class="form-control"
                                   type="number"
                                   min="1"
                                   placeholder="Enter your Booking ID" />

                            <span asp-validation-for="BookingID"
                                  class="text-danger">
                            </span>
                        </div>


                        <!-- Rating -->
                        <div class="mb-4">

                            <label asp-for="Rating"
                                   class="form-label fw-bold">
                                Rating
                            </label>

                            <select asp-for="Rating"
                                    class="form-select">

                                <option value="">
                                    -- Select Rating --
                                </option>

                                <option value="1">
                                    1 - Very Poor
                                </option>

                                <option value="2">
                                    2 - Poor
                                </option>

                                <option value="3">
                                    3 - Average
                                </option>

                                <option value="4">
                                    4 - Good
                                </option>

                                <option value="5">
                                    5 - Excellent
                                </option>

                            </select>

                            <span asp-validation-for="Rating"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Comments -->
                        <div class="mb-4">

                            <label asp-for="Comments"
                                   class="form-label fw-bold">
                                Your Comments
                            </label>

                            <textarea asp-for="Comments"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Write your feedback here...">
                            </textarea>

                            <span asp-validation-for="Comments"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Submit -->
                        <div class="text-center">

                            <button type="submit"
                                    class="btn btn-primary py-3 px-5">

                                <i class="fa fa-paper-plane me-2"></i>

                                Submit Feedback

                            </button>

                        </div>

                    </form>

                </div>

            </div>
        </div>

    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }
}

