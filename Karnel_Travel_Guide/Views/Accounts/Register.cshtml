@model Karnel_Travel_Guide.Models.User

@{
    ViewData["Title"] = "Register";
}

<style>
    .full-page-bg {
        background-color: #f4f8fb;
        width: 100%;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 150px 15px 40px 15px;
    }

    .account-card {
        width: 100%;
        max-width: 480px;
        border: none;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 10px 35px rgba(13, 110, 253, 0.15);
        background: #ffffff;
    }

    .account-header {
        background: linear-gradient(135deg, #0d6efd, #0a58ca);
        color: white;
        padding: 30px 25px;
        text-align: center;
    }

    .account-header-icon {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        font-size: 28px;
    }

    .account-header h2 {
        margin-bottom: 6px;
        font-weight: 700;
    }

    .account-header p {
        margin-bottom: 0;
        opacity: 0.9;
    }

    .account-body {
        padding: 30px;
    }

    .account-label {
        color: #173b63;
        font-weight: 600;
    }

    .account-input {
        border: 1px solid #c9dff5;
        border-radius: 8px;
        padding: 11px 13px;
    }

        .account-input:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.12);
        }

    .register-btn {
        background: linear-gradient(135deg, #0d6efd, #0a58ca);
        border: none;
        color: white;
        font-weight: 600;
        padding: 11px;
        border-radius: 8px;
    }

        .register-btn:hover {
            background: linear-gradient(135deg, #0a58ca, #084298);
            color: white;
        }

    .account-link {
        color: #0d6efd;
        font-weight: 600;
        text-decoration: none;
    }

        .account-link:hover {
            color: #084298;
        }

    .validation-message {
        font-size: 0.85rem;
        margin-top: 5px;
    }
</style>


<div class="full-page-bg">

    <div class="account-card">

        <!-- =====================================================
             HEADER
        ====================================================== -->
        <div class="account-header">

            <div class="account-header-icon">
                <i class="bi bi-person-plus"></i>
            </div>

            <h2>Create Account</h2>

            <p>
                Join Karnel Travel Guide
            </p>

        </div>


        <!-- =====================================================
             BODY
        ====================================================== -->
        <div class="account-body">


            <!-- SERVER ERROR -->
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-circle me-1"></i>
                    @ViewBag.Error
                </div>
            }


            <!-- MODEL VALIDATION SUMMARY -->
            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"
                 role="alert">
            </div>


            <!-- =================================================
                 REGISTER FORM
            ================================================== -->
            <form asp-action="Register"
                  asp-route-returnUrl="@ViewData["ReturnUrl"]"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- RETURN URL -->
                <input type="hidden"
                       name="returnUrl"
                       value="@ViewData["ReturnUrl"]" />


                <!-- =================================================
                     FULL NAME
                ================================================== -->
                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label account-label">
                        Full Name
                    </label>

                    <input asp-for="Name"
                           class="form-control account-input"
                           placeholder="Enter your full name"
                           autocomplete="name"
                           required />

                    <span asp-validation-for="Name"
                          class="text-danger validation-message">
                    </span>

                </div>


                <!-- =================================================
                     EMAIL
                ================================================== -->
                <div class="mb-3">

                    <label asp-for="Email"
                           class="form-label account-label">
                        Email
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control account-input"
                           placeholder="Enter your email"
                           autocomplete="email"
                           required />

                    <span asp-validation-for="Email"
                          class="text-danger validation-message">
                    </span>

                </div>


                <!-- =================================================
                     PHONE
                ================================================== -->
                <div class="mb-3">

                    <label asp-for="Phone"
                           class="form-label account-label">
                        Phone
                    </label>

                    <input asp-for="Phone"
                           type="tel"
                           class="form-control account-input"
                           placeholder="Enter your phone number"
                           autocomplete="tel" />

                    <span asp-validation-for="Phone"
                          class="text-danger validation-message">
                    </span>

                </div>


                <!-- =================================================
                     PASSWORD
                ================================================== -->
                <div class="mb-3">

                    <label asp-for="PasswordHash"
                           class="form-label account-label">
                        Password
                    </label>

                    <input asp-for="PasswordHash"
                           type="password"
                           class="form-control account-input"
                           placeholder="Create a password"
                           autocomplete="new-password"
                           required />

                    <span asp-validation-for="PasswordHash"
                          class="text-danger validation-message">
                    </span>

                </div>


                <!-- =================================================
                     REGISTER BUTTON
                ================================================== -->
                <div class="d-grid mt-4">

                    <button type="submit"
                            class="btn register-btn">

                        <i class="bi bi-person-plus me-1"></i>

                        Create Account

                    </button>

                </div>

            </form>


            <!-- =================================================
                 LOGIN LINK
            ================================================== -->
            <div class="text-center mt-4">

                <span class="text-muted">
                    Already have an account?
                </span>

                <a asp-controller="Accounts"
                   asp-action="Login"
                   asp-route-returnUrl="@ViewData["ReturnUrl"]"
                   class="account-link">

                    Login

                </a>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}