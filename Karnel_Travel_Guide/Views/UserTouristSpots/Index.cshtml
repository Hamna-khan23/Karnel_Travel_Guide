@model IEnumerable<Karnel_Travel_Guide.Models.TouristSpot>

@{
    ViewData["Title"] = "Tourist Spots";
}

<div class="container-fluid py-5">
    <div class="container py-5">

        <!-- Title -->
        <div class="text-center mb-5">
            <h5 class="text-primary text-uppercase">Destinations</h5>
            <h1 class="display-5">Explore Tourist Spots</h1>
        </div>

        <!-- Search & Filter Bar -->
        <form method="get" asp-controller="UserTouristSpots" asp-action="Index" class="mb-5">
            <div class="row g-3 justify-content-center">
                <div class="col-md-4">
                    <input type="text" name="searchString" class="form-control form-control-lg" placeholder="Search by spot name or keyword..." />
                </div>
                <div class="col-md-3">
                    <select name="city" class="form-select form-select-lg">
                        <option value="">All Cities</option>
                        @if (ViewBag.Cities != null)
                        {
                            foreach (var city in ViewBag.Cities)
                            {
                                <option value="@city">@city</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary btn-lg w-100">Search</button>
                </div>
            </div>
        </form>

        <!-- Tourist Spots Cards Grid -->
        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                @foreach (var spot in Model)
                {
                    string firstImage = "/images/default-spot.jpg"; // Default placeholder fallback
                    if (!string.IsNullOrEmpty(spot.ImageUrl))
                    {
                        var images = spot.ImageUrl.Split(',', StringSplitOptions.RemoveEmptyEntries);
                        if (images.Length > 0)
                        {
                            firstImage = images[0].Trim();
                        }
                    }

                    <div class="col-lg-4 col-md-6">
                        <div class="card h-100 shadow-sm border-0 rounded overflow-hidden">
                            <img src="@firstImage" class="card-img-top" alt="@spot.Name" style="height: 230px; object-fit: cover;" />
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-primary px-3 py-2">@spot.City</span>
                                    @if (!string.IsNullOrEmpty(spot.Category))
                                    {
                                        <span class="badge bg-secondary px-2 py-1">@spot.Category</span>
                                    }
                                </div>
                                <h4 class="card-title fw-bold mb-2">@spot.Name</h4>
                                <p class="card-text text-muted small mb-3">
                                    @(spot.Description != null && spot.Description.Length > 90 ? spot.Description.Substring(0, 90) + "..." : spot.Description)
                                </p>
                                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                    <span class="h5 fw-bold text-success">PKR @spot.PricePerNight</span>
                                    <small class="text-muted"> / Person</small>
                                    <a asp-controller="UserTouristSpots" asp-action="Details" asp-route-id="@spot.SpotID" class="btn btn-outline-primary btn-sm">
                                        View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <p class="text-muted fs-5">No tourist spots available right now.</p>
                </div>
            }
        </div>

    </div>
</div>