@model Karnel_Travel_Guide.Models.TouristSpot

@{
    ViewData["Title"] = Model.Name;

    // Comma-separated strings ko array me convert kar rahe hain
    List<string> imageList = new List<string>();
    if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        imageList = Model.ImageUrl.Split(',', StringSplitOptions.RemoveEmptyEntries)
                                  .Select(img => img.Trim())
                                  .ToList();
    }
}

<div class="container-fluid py-5">
    <div class="container py-5">

        <div class="row g-5">
            <!-- Left Side: Image Gallery -->
            <div class="col-lg-7">
                @if (imageList.Any())
                {
                    <div id="spotImageCarousel" class="carousel slide shadow rounded overflow-hidden" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            @for (int i = 0; i < imageList.Count; i++)
                            {
                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                    <img src="@imageList[i]" class="d-block w-100" alt="@Model.Name" style="height: 420px; object-fit: cover;" />
                                </div>
                            }
                        </div>
                        @if (imageList.Count > 1)
                        {
                            <button class="carousel-control-prev" type="button" data-bs-target="#spotImageCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon"></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#spotImageCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon"></span>
                            </button>
                        }
                    </div>

                    <!-- Thumbnail Grid -->
                    @if (imageList.Count > 1)
                    {
                        <div class="row g-2 mt-2">
                            @for (int i = 0; i < imageList.Count; i++)
                            {
                                <div class="col-3">
                                    <img src="@imageList[i]" class="img-fluid rounded border" style="height: 80px; width: 100%; object-fit: cover; cursor: pointer;" onclick="$('#spotImageCarousel').carousel(@i)" />
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <img src="/images/default-spot.jpg" class="img-fluid rounded shadow w-100" style="height: 400px; object-fit: cover;" />
                }
            </div>

            <!-- Right Side: Tourist Spot Info -->
            <div class="col-lg-5">
                <div class="bg-light p-4 rounded shadow-sm">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-primary">@Model.City</span>
                        @if (!string.IsNullOrEmpty(Model.Category))
                        {
                            <span class="badge bg-secondary">@Model.Category</span>
                        }
                    </div>

                    <h2 class="fw-bold mb-3">@Model.Name</h2>

                    <div class="d-flex align-items-center mb-3 text-muted">
                        <i class="fa fa-map-marker-alt text-danger me-2"></i>
                        <span>Located in @Model.City, Pakistan</span>
                    </div>

                    <h5 class="fw-bold mb-2">About Destination</h5>
                    <p class="text-muted mb-4" style="line-height: 1.7;">@Model.Description</p>

                    <!-- Related Packages Available -->
                    @if (Model.Packages != null && Model.Packages.Any())
                    {
                        <div class="mb-4">
                            <h6 class="fw-bold">Available Packages:</h6>
                            <ul class="list-group list-group-flush border-top border-bottom my-2">
                                @foreach (var pkg in Model.Packages)
                                {
                                    <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center px-0">
                                        <span><i class="fa fa-check-circle text-success me-2"></i>@pkg.Title</span>
                                        <span class="fw-bold text-primary">PKR @pkg.Price</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="d-grid gap-2">
                      
                        <a asp-controller="Bookings" asp-action="BookTouristSpot" asp-route-id="@Model.SpotID" class="btn btn-primary btn-lg">
                                <i class="fa fa-calendar-check me-2"></i> Book Now
                            </a>
                        
                        <a asp-controller="Packages" asp-action="Index" asp-route-spotId="@Model.SpotID" class="btn btn-primary btn-lg">
                            <i class="fa fa-box me-2"></i> View Tour Packages
                        </a>
                        <a asp-controller="UserTouristSpots" asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fa fa-arrow-left me-2"></i> Back to Tourist Spots
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>