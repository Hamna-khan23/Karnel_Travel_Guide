@model Karnel_Travel_Guide.Models.ContactMessage

@{
    ViewData["Title"] = "Contact Us";
}

<!-- Header Start -->
<div class="container-fluid bg-breadcrumb">
    <div class="container text-center py-5" style="max-width: 900px;">
        <h3 class="text-white display-3 mb-4">Contact Us</h3>

        <ol class="breadcrumb justify-content-center mb-0">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index">Home</a>
            </li>

            <li class="breadcrumb-item">
                <a href="#">Pages</a>
            </li>

            <li class="breadcrumb-item active text-white">
                Contact
            </li>
        </ol>
    </div>
</div>
<!-- Header End -->
<!-- Contact Start -->
<div class="container-fluid contact bg-light py-5">

    <div class="container py-5">

        <div class="mx-auto text-center mb-5" style="max-width: 900px;">

            <h5 class="section-title px-3">
                Contact Us
            </h5>

            <h1 class="mb-0">
                Contact For Any Query
            </h1>

        </div>


        <div class="row g-5 align-items-center">


            <!-- CONTACT INFORMATION -->
            <div class="col-lg-4">

                <div class="bg-white rounded p-4">

                    <div class="text-center mb-4">

                        <i class="fa fa-map-marker-alt fa-3x text-primary"></i>

                        <h4 class="text-primary">
                            Address
                        </h4>

                        <p class="mb-0">
                            Jameel Jamali Street,Karachi, Pakistan
                        </p>

                    </div>


                    <div class="text-center mb-4">

                        <i class="fa fa-phone-alt fa-3x text-primary mb-3"></i>

                        <h4 class="text-primary">
                            Mobile
                        </h4>

                        <p class="mb-0">
                            +92 332 398765
                        </p>

                        <p class="mb-0">
                            +92 332 30982
                        </p>

                    </div>


                    <div class="text-center">

                        <i class="fa fa-envelope-open fa-3x text-primary mb-3"></i>

                        <h4 class="text-primary">
                            Email
                        </h4>

                        <p class="mb-0">
                            Aptech@karneltravelguide.com
                        </p>

                    </div>

                </div>

            </div>


            <!-- CONTACT FORM -->
            <div class="col-lg-8">

                <h2 class="mb-3">
                    Send us a message
                </h2>

                <p class="lh-base mb-4">
                    Have a question or need information about our tours?
                    Send us a message and our team will get back to you.
                </p>


                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show"
                         role="alert">

                        <i class="fa fa-check-circle me-2"></i>

                        @TempData["SuccessMessage"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>

                    </div>
                }


                <form asp-controller="Contact"
                      asp-action="Index"
                      method="post">

                    @Html.AntiForgeryToken()


                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <div class="row g-3">


                        <!-- NAME -->
                        <div class="col-md-6">

                            <div class="form-floating">

                                <input asp-for="Name"
                                       class="form-control border-0"
                                       placeholder="Your Name" />

                                <label asp-for="Name">
                                    Your Name
                                </label>

                            </div>

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- EMAIL -->
                        <div class="col-md-6">

                            <div class="form-floating">

                                <input asp-for="Email"
                                       class="form-control border-0"
                                       placeholder="Your Email" />

                                <label asp-for="Email">
                                    Your Email
                                </label>

                            </div>

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- SUBJECT -->
                        <div class="col-12">

                            <div class="form-floating">

                                <input asp-for="Subject"
                                       class="form-control border-0"
                                       placeholder="Subject" />

                                <label asp-for="Subject">
                                    Subject
                                </label>

                            </div>

                            <span asp-validation-for="Subject"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- MESSAGE -->
                        <div class="col-12">

                            <div class="form-floating">

                                <textarea asp-for="Message"
                                          class="form-control border-0"
                                          placeholder="Leave a message here"
                                          style="height: 160px">
                                </textarea>

                                <label asp-for="Message">
                                    Message
                                </label>

                            </div>

                            <span asp-validation-for="Message"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- SUBMIT -->
                        <div class="col-12">

                            <button class="btn btn-primary w-100 py-3"
                                    type="submit">

                                <i class="fa fa-paper-plane me-2"></i>

                                Send Message

                            </button>

                        </div>

                    </div>

                </form>

            </div>


            <!-- MAP -->
            <div class="col-12">

                <div class="rounded">

                    <iframe class="rounded w-100"
                            style="height: 450px; border: 0;"
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d57889.511369472384!2d67.00364434126615!3d24.928851784353167!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3eb33f90157042d3%3A0x93d609e8bec9a880!2sAptech%20Computer%20Education%20North%20Nazimabad%20Center!5e0!3m2!1sen!2s!4v1789105991639!5m2!1sen!2s"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="strict-origin-when-cross-origin">
                    </iframe>

                </div>

            </div>

        </div>

    </div>

</div>
<!-- Contact End -->
@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}