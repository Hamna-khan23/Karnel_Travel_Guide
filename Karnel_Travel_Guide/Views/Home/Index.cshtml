            <p class="text-muted">
                Experience world-class comfort and luxury during your stay.
            </p>
        </div>

        <div class="row g-4">
            @if (Model.Resorts != null && Model.Resorts.Count > 0)
            {
                @foreach (var resort in Model.Resorts.Take(3))
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card package-card border-0 shadow-sm h-100">
                            @if (!string.IsNullOrEmpty(resort.ImageUrl))
                            {
                                var images = resort.ImageUrl.Split(',');
