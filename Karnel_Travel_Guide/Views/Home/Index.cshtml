@* @model HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<!-- ================= HERO SECTION ================= -->

<section class="hero-section position-relative py-4 bg-white">
    <div class="container position-relative py-3">
        <div class="row align-items-center justify-content-center text-center">
            <div class="col-lg-8 py-2 d-flex flex-column align-items-center">

                <span class="badge px-3 py-2 mb-3 text-white rounded-pill shadow-sm" style="background-color: #113264;">
                    KARNEL TRAVEL GUIDE
                </span>

                <h1 class="display-4 fw-bold mb-3" style="color: #113264;">
                    Explore Pakistan With Us
                </h1>

                <p class="text-muted">
                    Discover beautiful destinations, comfortable stays,
                    exciting travel packages and unforgettable experiences
                    across Pakistan.
                </p>

                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a asp-controller="UserTouristSpots"
                       asp-action="Index"
                       class="btn btn-lg px-4 text-white rounded-pill shadow-sm"
                       style="background-color: #113264; border-color: #113264; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size: 16px; font-weight: 600;">
                        Explore Destinations
                    </a>

                    <a asp-controller="Information"
                       asp-action="Index"
                       class="btn btn-lg px-4 text-white rounded-pill shadow-sm"
                       style="background-color: #113264; border-color: #113264; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size: 16px; font-weight: 600;">
                        View Information
                    </a>
                </div>

            </div>
        </div>
    </div>
</section>

<!-- ================= DISCOVER PAKISTAN ================= -->

<section class="py-4">
    <div class="container">

        <div class="text-center mb-4">
            <span class="fw-semibold" style="color: #113264; letter-spacing: 1px;">
                DINE WITH US
            </span>

            <h2 class="fw-bold mt-2" style="color: #113264;">
                Top Restaurants
            </h2>

            <p class="text-muted">
                Explore our available restaurants and enjoy your dining experience.
            </p>
        </div>

        <div class="row g-4">
            @if (Model != null && Model.Count > 0)
            {
                @foreach (var restaurant in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card package-card border-0 shadow-sm h-100">
                            @if (!string.IsNullOrEmpty(restaurant.ImageUrl))
                            {
                                var images = restaurant.ImageUrl.Split(',');
                                var firstImage = images.Length > 0 ? images[0].Trim() : "";

                                if (!string.IsNullOrEmpty(firstImage))
                                {
                                    <img src="@firstImage" class="card-img-top" alt="@restaurant.Name">
                                }
                            }
                            else
                            {
                                <img src="~/images/default-restaurant.jpg" class="card-img-top" alt="@restaurant.Name">
                            }

                            <div class="card-body p-4">
                                <h4 class="fw-bold" style="color: #113264;">
                                    @restaurant.Name
                                </h4>

                                <p class="text-muted">
                                    @restaurant.Description
                                </p>

                                <div class="d-flex justify-content-between mb-3">
                                    @if (!string.IsNullOrEmpty(restaurant.CuisineType))
                                    {
                                        <span>
                                            <i class="bi bi-tag"></i>
                                            @restaurant.CuisineType
                                        </span>
                                    }

                                    @if (restaurant.PriceRange > 0)
                                    {
                                        <strong style="color: #113264;">
                                            Rs. @restaurant.PriceRange.ToString("N0")
                                        </strong>
                                    }
                                </div>

                                @if (!string.IsNullOrEmpty(restaurant.City))
                                {
                                    <p class="small text-muted">
                                        <i class="bi bi-geo-alt"></i>
                                        @restaurant.City
                                    </p>
                                }

                                <a asp-controller="Restaurants"
                                   asp-action="Details"
                                   asp-route-id="@restaurant.RestaurantID"
                                   class="btn text-white w-100 rounded-pill shadow-sm"
                                   style="background-color: #113264; border-color: #113264;">
                                    View Restaurant
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="alert alert-light text-center border">
                        No restaurants are available at the moment.
                    </div>
                </div>
            }
        </div>

    </div>
</section>

