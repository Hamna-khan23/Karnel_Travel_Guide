<!-- ================= FEATURED TRAVEL & TRANSPORTATION ================= -->
<section class="py-4">
    <div class="container">

        <div class="text-center mb-4">
            <span class="fw-semibold" style="color: #113264; letter-spacing: 1px;">
                MOVE WITH US
            </span>

            <h2 class="fw-bold mt-2" style="color: #113264;">
                Travel & Transportation
            </h2>

            <p class="text-muted">
                Choose reliable bus, train, and flight options across Pakistan.
            </p>
        </div>

        <div class="row g-4">
            @if (ViewBag.Travels != null && ViewBag.Travels.Count > 0)
            {
                @foreach (var travel in ViewBag.Travels)
                {
                    string transportIcon = "bi-bus-front";
                    string iconBg = "#e8f1fd";
                    string iconColor = "#113264";

                    if (!string.IsNullOrEmpty(travel.TransportType))
                    {
                        var type = travel.TransportType.ToLower();
                        if (type.Contains("flight") || type.Contains("air") || type.Contains("plane"))
                        {
                            transportIcon = "bi-airplane";
                        }
                        else if (type.Contains("train") || type.Contains("rail"))
                        {
                            transportIcon = "bi-train-front";
                        }
                        else if (type.Contains("car") || type.Contains("van") || type.Contains("taxi"))
                        {
                            transportIcon = "bi-car-front";
                        }
                    }

                    <div class="col-md-6 col-lg-4">
                        <div class="card package-card border-0 shadow-sm h-100 rounded-4 overflow-hidden">

                            <!-- CARD HEADER WITH ICON & TRANSPORT TYPE -->
                            <div class="p-4 pb-3" style="background: linear-gradient(135deg, #113264, #1b4b91); color: white;">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                                             style="width: 48px; height: 48px; background: rgba(255,255,255,0.2); font-size: 22px;">
                                            <i class="bi @transportIcon"></i>
                                        </div>
                                        <div>
                                            <h5 class="fw-bold mb-0 text-white">@travel.TransportType</h5>
                                            <small class="text-light opacity-75">Scheduled Transport</small>
                                        </div>
                                    </div>
                                    <span class="badge bg-light text-dark rounded-pill px-3 py-2 fw-semibold">
                                        Rs. @travel.Price.ToString("N0")
                                    </span>
                                </div>
                            </div>

                            <!-- CARD BODY -->
                            <div class="card-body p-4 d-flex flex-column">

                                <!-- ROUTE CITIES -->
                                <div class="p-3 bg-light rounded-3 mb-3 border">
                                    <div class="d-flex justify-content-between align-items-center text-center">
                                        <div>
                                            <small class="text-muted d-block">From</small>
                                            <strong class="fs-6" style="color: #113264;">@travel.FromCity</strong>
                                        </div>
                                        <div>
                                            <i class="bi bi-arrow-right text-primary fs-5"></i>
                                        </div>
                                        <div>
                                            <small class="text-muted d-block">To</small>
                                            <strong class="fs-6" style="color: #113264;">@travel.ToCity</strong>
                                        </div>
                                    </div>
                                </div>

                                <!-- ROUTE VIA -->
                                @if (!string.IsNullOrEmpty(travel.Route))
                                {
                                    <p class="small text-muted mb-2">
                                        <i class="bi bi-signpost-split me-1 text-primary"></i> <strong>Route:</strong> @travel.Route
                                    </p>
                                }

                                <!-- TIMINGS -->
                                <div class="row g-2 mb-3 small text-muted">
                                    <div class="col-6">
                                        <i class="bi bi-clock me-1 text-primary"></i> Dep: <strong>@DateTime.Today.Add(travel.DepartureTime).ToString("hh:mm tt")</strong>
                                    </div>
                                    <div class="col-6 text-end">
                                        <i class="bi bi-clock-history me-1 text-primary"></i> Arr: <strong>@DateTime.Today.Add(travel.ArrivalTime).ToString("hh:mm tt")</strong>
                                    </div>
                                </div>

                                <!-- DESCRIPTION -->
                                @if (!string.IsNullOrEmpty(travel.Description))
                                {
                                    <p class="text-muted small mb-4 flex-grow-1">
                                        @travel.Description
                                    </p>
                                }
                                else
                                {
                                    <div class="flex-grow-1"></div>
                                }

                                <!-- BOOK NOW BUTTON -->
                                <a asp-controller="Bookings"
                                   asp-action="BookTravel"
                                   asp-route-id="@travel.TravelID"
                                   class="btn text-white w-100 rounded-pill shadow-sm mt-auto"
                                   style="background-color: #113264; border-color: #113264; font-weight: 600;">
                                    <i class="bi bi-ticket-perforated me-1"></i> Book Transport
                                </a>

                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="alert alert-light text-center border">
                        No transportation options are available at the moment.
                    </div>
                </div>
            }
        </div>

    </div>
</section>

<!-- ================= FEATURED RESORTS ================= -->
<section class="py-4">
    <div class="container">

        <div class="text-center mb-4">
            <span class="fw-semibold" style="color: #113264; letter-spacing: 1px;">
                STAY WITH US
            </span>

            <h2 class="fw-bold mt-2" style="color: #113264;">
                Featured Resorts
            </h2>

            <p class="text-muted">
                Experience world-class comfort and luxury during your stay.
            </p>
        </div>

        <div class="row g-4">
            @if (ViewBag.Resorts != null && ViewBag.Resorts.Count > 0)
            {
                @foreach (var resort in ViewBag.Resorts)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card package-card border-0 shadow-sm h-100">
                            @if (!string.IsNullOrEmpty(resort.ImageUrl))
                            {
                                var images = ((string)resort.ImageUrl).Split(',');
                                var firstImage = images.Length > 0 ? images[0].Trim() : "";

                                if (!string.IsNullOrEmpty(firstImage))
                                {
                                    <img src="@firstImage" class="card-img-top" alt="@resort.Name" style="height: 220px; object-fit: cover;">
                                }
                            }
                            else
                            {
                                <img src="~/images/default-resort.jpg" class="card-img-top" alt="@resort.Name" style="height: 220px; object-fit: cover;">
                            }

                            <div class="card-body p-4">
                                <h4 class="fw-bold" style="color: #113264;">
                                    @resort.Name
                                </h4>

                                <p class="text-muted">
                                    @resort.Description
                                </p>

                                <div class="d-flex justify-content-between mb-3">
                                    @if (!string.IsNullOrEmpty(resort.City))
                                    {
                                        <span class="small text-muted">
                                            <i class="bi bi-geo-alt"></i>
                                            @resort.City
                                        </span>
                                    }

                                    <strong style="color: #113264;">
                                        Rs. @resort.PricePerNight.ToString("N0") / Night
                                    </strong>
                                </div>

                                <a asp-controller="Resorts"
                                   asp-action="Details"
                                   asp-route-id="@resort.ResortID"
                                   class="btn text-white w-100 rounded-pill shadow-sm"
                                   style="background-color: #113264; border-color: #113264;">
                                    View Resort
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="alert alert-light text-center border">
                        No resorts are available at the moment.
                    </div>
                </div>
            }
        </div>

    </div>
</section>

