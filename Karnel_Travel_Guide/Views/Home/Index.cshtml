                                if (!string.IsNullOrEmpty(firstImage))
                                {
                                    <img src="@firstImage" class="card-img-top" alt="@resort.Name" style="height: 220px; object-fit: cover;">
                                }
                            }
                            else
                            {
                                <img src="~/images/default-resort.jpg" class="card-img-top" alt="@resort.Name" style="height: 220px; object-fit: cover;">
                            }

                            <div class="card-body p-4">
                                <h4 class="fw-bold" style="color: #113264;">
                                    @resort.Name
                                </h4>

                                <p class="text-muted">
