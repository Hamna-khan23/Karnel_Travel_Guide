@{
    ViewData["Title"] = "Booking Confirmation";
}

<div class="container py-5 ">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="card border-0 shadow-sm rounded-4 p-5 bg-light">
                <div class="mb-4">
                    <i class="fa fa-check-circle text-success fa-5x"></i>
                </div>
                <h1 class="fw-bold text-success mb-3">Booking Confirmed!</h1>
                <p class="text-muted fs-5 mb-4">Thank you for your booking with Karnel Travel Guide. Your reservation has been successfully placed and saved.</p>

                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Bookings" asp-action="MyBookings" class="btn text-white rounded-pill px-4 py-2 fw-semibold shadow-sm" style="background-color: #113264;">
                        View My Bookings
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">
                        Go to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>