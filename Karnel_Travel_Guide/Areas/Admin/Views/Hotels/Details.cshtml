@model Karnel_Travel_Guide.Models.Hotel

@{
    ViewData["Title"] = "Hotel Details";
}

<div class="container-fluid px-3 px-lg-4 py-4">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Hotel Details</h2>
        <p class="text-muted mb-0">View complete hotel information</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-12 mb-3">
                    <strong>Hotel Gallery</strong>
                    <div class="mt-2 d-flex flex-wrap gap-2">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            var images = Model.ImageUrl.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries);
                            foreach (var img in images)
                            {
                                <img src="@Url.Content(img.Trim())" alt="@Model.Name" class="shadow-sm border rounded" style="max-height: 180px; width: 180px; object-fit: cover;" />
                            }
                        }
                        else
                        {
                            <span class="text-muted">No Image Available</span>
                        }
                    </div>
                </div>
                <div class="col-md-6">
                    <strong>Hotel Name</strong>
                    <div class="mt-1">@Model.Name</div>
                </div>

                <div class="col-md-6">
                    <strong>City</strong>
                    <div class="mt-1">@Model.City</div>
                </div>

                <div class="col-md-4">
                    <strong>Price Per Night</strong>
                    <div class="mt-1">@Model.PricePerNight.ToString("N2")</div>
                </div>

                <div class="col-md-4">
                    <strong>Rating</strong>
                    <div class="mt-1">
                        <span class="badge bg-warning text-dark">
                            <i class="bi bi-star-fill me-1"></i> @Model.Rating
                        </span>
                    </div>
                </div>

                <div class="col-md-4">
                    <strong>Total Rooms</strong>
                    <div class="mt-1">@Model.TotalRooms</div>
                </div>

                <div class="col-md-12">
                    <strong>Availability</strong>
                    <div class="mt-1">
                        @if (Model.Availability)
                        {
                            <span class="badge bg-success">Available</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Not Available</span>
                        }
                    </div>
                </div>

                <div class="col-md-12">
                    <strong>Description</strong>
                    <div class="mt-1">
                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            @Model.Description
                        }
                        else
                        {
                            <span class="text-muted">N/A</span>
                        }
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <a asp-area="Admin"
                   asp-controller="Hotels"
                   asp-action="Edit"
                   asp-route-hotelid="@Model.HotelID"
                   class="btn btn-warning">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>

                <a asp-area="Admin"
                   asp-controller="Hotels"
                   asp-action="Index"
                   class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
            </div>
        </div>
    </div>
</div>
