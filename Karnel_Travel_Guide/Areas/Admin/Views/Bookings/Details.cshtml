@model Karnel_Travel_Guide.Models.Booking

@{
    ViewData["Title"] = "Booking Details";
}

<div class="container-fluid px-3 px-lg-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Booking Details</h2>
            <p class="text-muted mb-0">
                View complete booking information
            </p>
        </div>

        <div>
            <a asp-area="Admin"
               asp-controller="Bookings"
               asp-action="Edit"
               asp-route-bookingid="@Model.BookingID"
               class="btn btn-warning">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>

            <a asp-area="Admin"
               asp-controller="Bookings"
               asp-action="Index"
               class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">

            <dl class="row mb-0">

                <dt class="col-sm-3">Booking ID</dt>
                <dd class="col-sm-9 fw-bold">#@Model.BookingID</dd>

                <dt class="col-sm-3">Customer Name</dt>
                <dd class="col-sm-9">
                    @(Model.User != null ? Model.User.Name : "N/A")
                </dd>

                <dt class="col-sm-3">Customer Email</dt>
                <dd class="col-sm-9">
                    @(Model.User != null ? Model.User.Email : "N/A")
                </dd>

                <hr class="my-3 text-muted" />

                <!-- Package -->
                <dt class="col-sm-3">Package</dt>
                <dd class="col-sm-9">
                    @if (Model.Package != null)
                    {
                        <span class="badge bg-warning text-dark fs-6">@Model.Package.Title</span>
                    }
                    else
                    {
                        <span class="text-muted">N/A</span>
                    }
                </dd>

                <!-- Hotel -->
                <dt class="col-sm-3">Hotel</dt>
                <dd class="col-sm-9">
                    @if (Model.Hotel != null)
                    {
                        <span class="badge bg-primary fs-6">@Model.Hotel.Name</span>
                    }
                    else
                    {
                        <span class="text-muted">N/A</span>
                    }
                </dd>

                <!-- Resort -->
                <dt class="col-sm-3">Resort</dt>
                <dd class="col-sm-9">
                    @if (Model.Resort != null)
                    {
                        <span class="badge bg-success fs-6">@Model.Resort.Name</span>
                    }
                    else
                    {
                        <span class="text-muted">N/A</span>
                    }
                </dd>

                <!-- Tourist Spot (NEW) -->
                <dt class="col-sm-3">Tourist Spot</dt>
                <dd class="col-sm-9">
                    @if (Model.TouristSpot != null)
                    {
                        <span class="badge bg-info text-dark fs-6">@Model.TouristSpot.Name</span>
                    }
                    else
                    {
                        <span class="text-muted">N/A</span>
                    }
                </dd>

                <!-- Restaurant (NEW) -->
                <dt class="col-sm-3">Restaurant</dt>
                <dd class="col-sm-9">
                    @if (Model.Restaurant != null)
                    {
                        <span class="badge bg-secondary fs-6">@Model.Restaurant.Name</span>
                    }
                    else
                    {
                        <span class="text-muted">N/A</span>
                    }
                </dd>

                <!-- Travel -->
                <dt class="col-sm-3">Travel Transport</dt>
                <dd class="col-sm-9">
                    @if (Model.TravelInformation != null)
                    {
                        <span class="badge bg-dark fs-6">@Model.TravelInformation.TransportType</span>
                    }
                    else
                    {
                        <span class="text-muted">N/A</span>
                    }
                </dd>

                <hr class="my-3 text-muted" />

                <!-- CheckIn / Trip Date -->
                <dt class="col-sm-3">Trip / Check-In Date</dt>
                <dd class="col-sm-9">@Model.CheckInDate.ToString("dd-MM-yyyy")</dd>

                @if (Model.HotelID.HasValue || Model.ResortID.HasValue || Model.PackageID.HasValue)
                {
                    <dt class="col-sm-3">Check-Out Date</dt>
                    <dd class="col-sm-9">@Model.CheckOutDate.ToString("dd-MM-yyyy")</dd>

                    <dt class="col-sm-3">Nights</dt>
                    <dd class="col-sm-9">@Model.Nights</dd>
                }

                <dt class="col-sm-3">Booking Date</dt>
                <dd class="col-sm-9">@Model.BookingDate.ToString("dd-MM-yyyy HH:mm")</dd>

                <dt class="col-sm-3">Persons</dt>
                <dd class="col-sm-9">@Model.Persons</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.Status == "Confirmed")
                    {
                        <span class="badge bg-success">Confirmed</span>
                    }
                    else if (Model.Status == "Cancelled")
                    {
                        <span class="badge bg-danger">Cancelled</span>
                    }
                    else if (Model.Status == "Completed")
                    {
                        <span class="badge bg-primary">Completed</span>
                    }
                    else if (Model.Status == "Reserved")
                    {
                        <span class="badge bg-info text-dark">Reserved</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">@Model.Status</span>
                    }
                </dd>

                <!-- Total Amount / Price Range -->
                <dt class="col-sm-3">Total / Price</dt>
                <dd class="col-sm-9 fw-bold text-success fs-5">
                    @if (Model.RestaurantID.HasValue)
                    {
                        <span>Price Range: @(Model.PriceRange ?? "N/A")</span>
                    }
                    else
                    {
                        <span>Rs. @Model.TotalAmount.ToString("N2")</span>
                    }
                </dd>

                <dt class="col-sm-3">Special Request</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.SpecialRequest))
                    {
                        <div class="p-2 bg-light rounded border text-dark">@Model.SpecialRequest</div>
                    }
                    else
                    {
                        <span class="text-muted">No special request</span>
                    }
                </dd>

            </dl>

        </div>
    </div>

</div>