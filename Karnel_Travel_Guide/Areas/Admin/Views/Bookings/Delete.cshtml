@model Karnel_Travel_Guide.Models.Booking

@{
    ViewData["Title"] = "Delete Booking";
    string itemName = "N/A";
    if (Model.Package != null) { itemName = "Package: " + Model.Package.Title; }
    else if (Model.Hotel != null) { itemName = "Hotel: " + Model.Hotel.Name; }
    else if (Model.Resort != null) { itemName = "Resort: " + Model.Resort.Name; }
    else if (Model.TouristSpot != null) { itemName = "Spot: " + Model.TouristSpot.Name; }
    else if (Model.Restaurant != null) { itemName = "Restaurant: " + Model.Restaurant.Name; }
    else if (Model.TravelInformation != null) { itemName = "Travel: " + Model.TravelInformation.TransportType; }
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4">

                <div class="text-center mb-4">
                    <div class="text-danger mb-2">
                        <i class="bi bi-exclamation-triangle-fill" style="font-size: 3rem;"></i>
                    </div>
                    <h3 class="fw-bold text-danger">Delete Booking</h3>
                    <p class="text-muted">Are you sure you want to permanently delete this booking?</p>
                </div>

                <div class="bg-light p-3 rounded-3 mb-4">
                    <div class="row g-2">
                        <div class="col-sm-4 text-muted">Booking ID:</div>
                        <div class="col-sm-8 fw-bold">#@Model.BookingID</div>

                        <div class="col-sm-4 text-muted">Customer Name:</div>
                        <div class="col-sm-8 fw-semibold">@(Model.User != null ? Model.User.Name : "N/A")</div>

                        <div class="col-sm-4 text-muted">Customer Email:</div>
                        <div class="col-sm-8">@(Model.User != null ? Model.User.Email : "N/A")</div>

                        <div class="col-sm-4 text-muted">Booked Item:</div>
                        <div class="col-sm-8 text-primary fw-bold">@itemName</div>

                        <div class="col-sm-4 text-muted">Persons:</div>
                        <div class="col-sm-8">@Model.Persons</div>

                        <div class="col-sm-4 text-muted">Booking Date:</div>
                        <div class="col-sm-8">@Model.BookingDate.ToString("dd MMM, yyyy")</div>

                        <div class="col-sm-4 text-muted">Status:</div>
                        <div class="col-sm-8">
                            <span class="badge bg-secondary">@Model.Status</span>
                        </div>

                        <div class="col-sm-4 text-muted">Total Amount:</div>
                        <div class="col-sm-8 fw-bold text-success">
                            @(Model.RestaurantID.HasValue ? "Price Range: " + Model.PriceRange : "Rs. " + Model.TotalAmount.ToString("N2"))
                        </div>
                    </div>
                </div>

                <form asp-area="Admin" asp-controller="Bookings" asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bookingid" value="@Model.BookingID" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-area="Admin" asp-controller="Bookings" asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-danger px-4 rounded-pill fw-semibold">
                            <i class="bi bi-trash me-1"></i> Yes, Delete Booking
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>