@{
    Layout = null; // Clean login page ke liye layout disable kiya hai
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="min-height: 100vh;">

    <div class="card shadow p-4" style="width: 100%; max-width: 400px; border-radius: 10px;">
        <h3 class="text-center mb-4 font-weight-bold">Admin Portal</h3>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger p-2 text-center">@ViewBag.Error</div>
        }

        <form asp-area="Admin" asp-controller="Account" asp-action="Login" method="post">
            <div class="mb-3">
                <label class="form-label">Email Address</label>
                <input type="email" name="email" class="form-control" placeholder="" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control" placeholder="" required />
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2">Login</button>
        </form>
    </div>

</body>
</html>