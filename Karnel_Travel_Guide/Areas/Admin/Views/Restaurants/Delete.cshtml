@model Karnel_Travel_Guide.Models.Restaurant

@{
    ViewData["Title"] = "Delete Restaurant";
}

<div class="container-fluid px-3 px-lg-4 py-4">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Delete Restaurant</h2>
        <p class="text-muted mb-0">Confirm deletion of this restaurant</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-2"></i>
                <strong>Are you sure?</strong> This action cannot be undone.
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-12 mb-2">
                    <strong>Restaurant Images</strong>
                    <div class="mt-2 d-flex flex-wrap gap-2">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            var images = Model.ImageUrl.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries);
                            foreach (var img in images)
                            {
                                <img src="@Url.Content(img.Trim())" alt="@Model.Name" class="shadow-sm border rounded" style="max-height: 120px; width: 120px; object-fit: cover;" />
                            }
                        }
                        else
                        {
                            <span class="text-muted">No Image Available</span>
                        }
                    </div>
                </div>

                <div class="col-md-6">
                    <strong>Name</strong>
                    <div class="mt-1">@Model.Name</div>
                </div>

                <div class="col-md-6">
                    <strong>Cuisine</strong>
                    <div class="mt-1">@Model.Cuisine</div>
                </div>

                <div class="col-md-4">
                    <strong>Price Range</strong>
                    <div class="mt-1">@Model.PriceRange</div>
                </div>

                <div class="col-md-4">
                    <strong>Rating</strong>
                    <div class="mt-1">@Model.Rating</div>
                </div>

                <div class="col-md-4">
                    <strong>City</strong>
                    <div class="mt-1">@Model.City</div>
                </div>
            </div>

            <form asp-area="Admin"
                  asp-controller="Restaurants"
                  asp-action="Delete"
                  asp-route-restaurantid="@Model.RestaurantID"
                  method="post">

                <input type="hidden" asp-for="RestaurantID" />

                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash me-1"></i> Delete Restaurant
                </button>

                <a asp-area="Admin"
                   asp-controller="Restaurants"
                   asp-action="Index"
                   class="btn btn-secondary ms-2">
                    <i class="bi bi-arrow-left me-1"></i> Cancel
                </a>
            </form>
        </div>
    </div>
</div>