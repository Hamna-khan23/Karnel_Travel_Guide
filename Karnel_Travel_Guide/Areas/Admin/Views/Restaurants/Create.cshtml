
@model Karnel_Travel_Guide.Models.Restaurant

@{
    ViewData["Title"] = "Create Restaurant";
}

<div class="container-fluid px-3 px-lg-4 py-4">

    <!-- Page Header -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1">
            Create Restaurant
        </h2>
        <p class="text-muted mb-0">
            Add a new restaurant
        </p>
    </div>

    <!-- Form Card -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">
                Restaurant Information
            </h5>
        </div>

        <div class="card-body p-4">

            <form asp-area="Admin"
                  asp-controller="Restaurants"
                  asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row g-3">

                    <!-- Name -->
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <!-- Cuisine -->
                    <div class="col-md-6">
                        <label asp-for="Cuisine" class="form-label fw-semibold"></label>
                        <input asp-for="Cuisine" class="form-control" />
                        <span asp-validation-for="Cuisine" class="text-danger"></span>
                    </div>

                    <!-- Price Range -->
                    <div class="col-md-6">
                        <label asp-for="PriceRange" class="form-label fw-semibold"></label>
                        <input asp-for="PriceRange" class="form-control" />
                        <span asp-validation-for="PriceRange" class="text-danger"></span>
                    </div>

                    <!-- Rating -->
                    <div class="col-md-6">
                        <label asp-for="Rating" class="form-label fw-semibold"></label>
                        <input asp-for="Rating" class="form-control" type="number" step="0.1" min="0" max="5" />
                        <span asp-validation-for="Rating" class="text-danger"></span>
                    </div>

                    <!-- City -->
                    <div class="col-md-6">
                        <label asp-for="City" class="form-label fw-semibold"></label>
                        <input asp-for="City" class="form-control" />
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>

                    <!-- Availability -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold d-block">
                            Availability
                        </label>
                        <div class="form-check mt-2">
                            <input asp-for="Availability" class="form-check-input" />
                            <label asp-for="Availability" class="form-check-label"></label>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <!-- Image Upload (Multiple) -->
                    <div class="col-md-12">
                        <label class="form-label fw-semibold">Restaurant Images</label>
                        <input type="file" name="imageFiles" class="form-control" accept="image/*" multiple />
                        <small class="text-muted">Select restaurant images from your computer.</small>
                    </div>

                </div>

                <!-- Buttons -->
                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-success rounded-3 px-4">
                        <i class="bi bi-plus-circle me-1"></i>
                        Create
                    </button>
                    <a asp-area="Admin" asp-controller="Restaurants" asp-action="Index" class="btn btn-secondary rounded-3 px-4">
                        <i class="bi bi-arrow-left me-1"></i>
                        Back to List
                    </a>
                </div>

            </form>

        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}