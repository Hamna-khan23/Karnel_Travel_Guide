
@model Karnel_Travel_Guide.Models.Restaurant

@{
    ViewData["Title"] = "Restaurant Details";
}

<div class="container-fluid px-4 px-lg-5 py-4">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Restaurant Details
            </h2>

            <p class="text-muted mb-0">
                View complete restaurant information
            </p>
        </div>

        <div>

            <a asp-action="Index"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Back to List

            </a>

        </div>

    </div>


    <!-- Details Card -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">

            <h5 class="fw-bold mb-0">
                @Model.Name
            </h5>

        </div>


        <div class="card-body p-4">

            <div class="row g-4">

                <!-- Restaurant Gallery -->
                <div class="col-12 mb-3">
                    <div class="d-flex">
                        <div class="text-muted" style="width: 195px;">
                            Restaurant Gallery
                        </div>
                        <div class="mt-2 d-flex flex-wrap gap-2">
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                var images = Model.ImageUrl.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries);
                                foreach (var img in images)
                                {
                                    <img src="@Url.Content(img.Trim())" alt="@Model.Name" class="shadow-sm border rounded" style="max-height: 180px; width: 180px; object-fit: cover;" />
                                }
                            }
                            else
                            {
                                <span class="text-muted">No Image Available</span>
                            }
                        </div>
                    </div>
                </div>


                <!-- Restaurant ID -->
                <div class="col-12 col-md-6">

                    <div class="d-flex">

                        <div class="text-muted" style="width: 195px;">
                            Restaurant ID
                        </div>

                        <div>
                            <strong>
                                @Model.RestaurantID
                            </strong>
                        </div>

                    </div>

                </div>


                <!-- Name -->
                <div class="col-12 col-md-6">

                    <div class="d-flex">

                        <div class="text-muted" style="width: 195px;">
                            Name
                        </div>

                        <div>
                            @Model.Name
                        </div>

                    </div>

                </div>


                <!-- Cuisine -->
                <div class="col-12 col-md-6">

                    <div class="d-flex">

                        <div class="text-muted" style="width: 195px;">
                            Cuisine
                        </div>

                        <div>
                            @Model.Cuisine
                        </div>

                    </div>

                </div>


                <!-- Price Range -->
                <div class="col-12 col-md-6">

                    <div class="d-flex">

                        <div class="text-muted" style="width: 195px;">
                            Price Range
                        </div>

                        <div>
                            @Model.PriceRange
                        </div>

                    </div>

                </div>


                <!-- Rating -->
                <div class="col-12 col-md-6">

                    <div class="d-flex">

                        <div class="text-muted" style="width: 195px;">
                            Rating
                        </div>

                        <div>

                            <span class="badge bg-warning text-dark">
                                @Model.Rating
                            </span>

                        </div>

                    </div>

                </div>


                <!-- City -->
                <div class="col-12 col-md-6">

                    <div class="d-flex">

                        <div class="text-muted" style="width: 195px;">
                            City
                        </div>

                        <div>
                            @Model.City
                        </div>

                    </div>

                </div>


                <!-- Availability -->
                <div class="col-12 col-md-6">

                    <div class="d-flex">

                        <div class="text-muted" style="width: 195px;">
                            Availability
                        </div>

                        <div>

                            @if (Model.Availability)
                            {
                                <span class="badge bg-success">
                                    Available
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Not Available
                                </span>
                            }

                        </div>

                    </div>

                </div>


                <!-- Description -->
                <div class="col-12">

                    <div class="d-flex">

                        <div class="text-muted" style="width: 195px;">
                            Description
                        </div>

                        <div>
                            @Model.Description
                        </div>

                    </div>

                </div>

            </div>


            <!-- Divider -->
            <hr class="my-4" />


            <!-- Buttons -->
            <div class="d-flex flex-wrap gap-2">

                <!-- Edit -->
                <a asp-action="Edit"
                   asp-route-restaurantid="@Model.RestaurantID"
                   class="btn btn-warning">

                    <i class="bi bi-pencil me-1"></i>
                    Edit

                </a>


                <!-- Delete -->
                <a asp-action="Delete"
                   asp-route-restaurantid="@Model.RestaurantID"
                   class="btn btn-danger">

                    <i class="bi bi-trash me-1"></i>
                    Delete

                </a>


                <!-- Back to List -->
                <a asp-action="Index"
                   class="btn btn-secondary">

                    <i class="bi bi-arrow-left me-1"></i>
                    Back to List

                </a>

            </div>

        </div>

    </div>
</div>