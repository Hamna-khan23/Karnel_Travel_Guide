@model Karnel_Travel_Guide.Models.Resort

@{
    ViewData["Title"] = "Edit Resort";
}

<div class="container-fluid px-3 px-lg-4 py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Edit Resort</h2>
            <p class="text-muted mb-0">Update resort information and images</p>
        </div>
        <div>
            <a asp-area="Admin" asp-controller="Resorts" asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Resort Information</h5>
        </div>

        <div class="card-body p-4">
            <form asp-area="Admin" asp-controller="Resorts" asp-action="Edit" asp-route-id="@Model.ResortID" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="ResortID" />
                <input type="hidden" asp-for="ImageUrl" />

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="City" class="form-label fw-semibold"></label>
                        <input asp-for="City" class="form-control" />
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="PricePerNight" class="form-label fw-semibold"></label>
                        <input asp-for="PricePerNight" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="PricePerNight" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Amenities" class="form-label fw-semibold"></label>
                        <input asp-for="Amenities" class="form-control" />
                        <span asp-validation-for="Amenities" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Rating" class="form-label fw-semibold"></label>
                        <input asp-for="Rating" class="form-control" type="number" step="0.1" min="0" max="5" />
                        <span asp-validation-for="Rating" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold d-block">Availability</label>
                        <div class="form-check mt-2">
                            <input asp-for="Availability" class="form-check-input" />
                            <label asp-for="Availability" class="form-check-label">Available</label>
                        </div>
                        <span asp-validation-for="Availability" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <!-- EXISTING IMAGES WITH REMOVE OPTION -->
                    <div class="col-12">
                        <label class="form-label fw-semibold d-block">Current Images</label>
                        @if (!string.IsNullOrEmpty(Model?.ImageUrl))
                        {
                            var images = Model.ImageUrl.Split(',', StringSplitOptions.RemoveEmptyEntries);
                            <div class="d-flex flex-wrap gap-3 mb-3">
                                @foreach (var imgPath in images)
                                {
                                    <div class="position-relative border rounded p-2 text-center bg-light">
                                        <img src="@imgPath.Trim()" alt="Resort Image" class="img-thumbnail mb-2" style="height: 100px; width: 120px; object-fit: cover;" />
                                        <div class="form-check justify-content-center d-flex gap-1 align-items-center">
                                            <input type="checkbox" name="imagesToDelete" value="@imgPath.Trim()" class="form-check-input btn-check-danger" id="del_@imgPath.GetHashCode()" />
                                            <label class="form-check-label text-danger small fw-bold" for="del_@imgPath.GetHashCode()">
                                                <i class="bi bi-trash"></i> Remove
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small">No existing images found.</p>
                        }
                    </div>

                    <!-- ADD NEW IMAGES -->
                    <div class="col-12">
                        <label class="form-label fw-semibold">Add New Images</label>
                        <input type="file" name="imageFiles" class="form-control" accept="image/*" multiple />
                        <small class="text-muted d-block mt-1">Select new images to append.</small>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-save me-1"></i> Save Changes
                    </button>
                    <a asp-area="Admin" asp-controller="Resorts" asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}