@model Karnel_Travel_Guide.Models.ContactMessage

@{
    ViewData["Title"] = "Message Details";
}

<div class="container-fluid px-3 px-lg-4 py-4">

    <!-- Page Header -->
    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            Message Details
        </h2>

        <p class="text-muted mb-0">
            View the complete contact message
        </p>

    </div>


    <!-- Message Card -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">

            <h5 class="mb-0 fw-bold">
                Contact Message
            </h5>

        </div>


        <div class="card-body">

            <!-- Message ID -->
            <div class="mb-3">
                <label class="fw-bold">
                    Message ID
                </label>

                <p class="form-control-plaintext">
                    @Model.MessageID
                </p>
            </div>


            <!-- Name -->
            <div class="mb-3">
                <label class="fw-bold">
                    Name
                </label>

                <p class="form-control-plaintext">
                    @Model.Name
                </p>
            </div>


            <!-- Email -->
            <div class="mb-3">
                <label class="fw-bold">
                    Email
                </label>

                <p class="form-control-plaintext">
                    @Model.Email
                </p>
            </div>


            <!-- Subject -->
            <div class="mb-3">
                <label class="fw-bold">
                    Subject
                </label>

                <p class="form-control-plaintext">
                    @Model.Subject
                </p>
            </div>


            <!-- Message -->
            <div class="mb-3">
                <label class="fw-bold">
                    Message
                </label>

                <div class="border rounded p-3 bg-light">
                    @Model.Message
                </div>
            </div>


            <!-- Date -->
            <div class="mb-4">
                <label class="fw-bold">
                    Date
                </label>

                <p class="form-control-plaintext">
                    @Model.Date.ToString("dd-MM-yyyy hh:mm tt")
                </p>
            </div>


            <!-- Buttons -->
            <div class="d-flex gap-2">

                <!-- Back -->
                <a class="btn btn-secondary"
                   asp-area="Admin"
                   asp-controller="ContactMessages"
                   asp-action="Index">

                    <i class="bi bi-arrow-left"></i>
                    Back to Messages

                </a>


                <!-- Delete -->
                <a class="btn btn-danger"
                   asp-area="Admin"
                   asp-controller="ContactMessages"
                   asp-action="Delete"
                   asp-route-messageid="@Model.MessageID">

                    <i class="bi bi-trash"></i>
                    Delete

                </a>

            </div>

        </div>

    </div>

</div>