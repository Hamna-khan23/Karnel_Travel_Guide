@model IEnumerable<Karnel_Travel_Guide.Models.ContactMessage>

@{
    ViewData["Title"] = "Contact Messages";
}

<div class="container-fluid px-3 px-lg-4 py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Contact Messages
            </h2>

            <p class="text-muted mb-0">
                View messages submitted by website visitors
            </p>
        </div>

    </div>


    <!-- Messages Card -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">

            <h5 class="mb-0 fw-bold">
                All Messages
            </h5>

        </div>


        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>

                                <th>
                                    ID
                                </th>

                                <th>
                                    Name
                                </th>

                                <th>
                                    Email
                                </th>

                                <th>
                                    Subject
                                </th>

                                <th>
                                    Date
                                </th>

                                <th>
                                    Actions
                                </th>

                            </tr>
                        </thead>


                        <tbody>

                            @foreach (var message in Model)
                            {
                                <tr>

                                    <!-- Message ID -->
                                    <td>
                                        @message.MessageID
                                    </td>


                                    <!-- Name -->
                                    <td>
                                        <strong>
                                            @message.Name
                                        </strong>
                                    </td>


                                    <!-- Email -->
                                    <td>
                                        @message.Email
                                    </td>


                                    <!-- Subject -->
                                    <td>
                                        @message.Subject
                                    </td>


                                    <!-- Date -->
                                    <td>
                                        @message.Date.ToString("dd-MM-yyyy hh:mm tt")
                                    </td>


                                    <!-- Actions -->
                                    <td>

                                        <div class="d-flex gap-2">

                                            <!-- Details -->
                                            <a class="btn btn-sm btn-info text-white"
                                               asp-area="Admin"
                                               asp-controller="ContactMessages"
                                               asp-action="Details"
                                               asp-route-messageid="@message.MessageID">

                                                <i class="bi bi-eye"></i>
                                                Details

                                            </a>


                                            <!-- Delete -->
                                            <a class="btn btn-sm btn-danger"
                                               asp-area="Admin"
                                               asp-controller="ContactMessages"
                                               asp-action="Delete"
                                               asp-route-messageid="@message.MessageID">

                                                <i class="bi bi-trash"></i>
                                                Delete

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- No Messages -->
                <div class="text-center py-5">

                    <i class="bi bi-envelope fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No messages found
                    </h5>

                    <p class="text-muted">
                        There are currently no contact messages.
                    </p>

                </div>
            }

        </div>

    </div>

</div>