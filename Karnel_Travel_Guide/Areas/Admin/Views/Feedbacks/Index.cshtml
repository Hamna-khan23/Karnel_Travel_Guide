@model IEnumerable<Karnel_Travel_Guide.Models.Feedback>

@{
    ViewData["Title"] = "Feedback";
}

<div class="container-fluid px-3 px-lg-4 py-4">

    <!-- ================= PAGE HEADER ================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Feedback
            </h2>

            <p class="text-muted mb-0">
                Manage customer feedback
            </p>
        </div>

    </div>


    <!-- ================= FEEDBACK CARD ================= -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">

            <h5 class="mb-0 fw-bold">
                All Feedback
            </h5>

        </div>


        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>

                                <th>
                                    ID
                                </th>

                                <th>
                                    User
                                </th>

                                <th>
                                    Rating
                                </th>

                                <th>
                                    Comments
                                </th>

                                <th>
                                    Date
                                </th>

                                <th>
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var feedback in Model)
                            {
                                <tr>

                                    <!-- Feedback ID -->

                                    <td>
                                        @feedback.FeedbackID
                                    </td>


                                    <!-- User -->

                                    <td>

                                        @if (feedback.User != null)
                                        {
                                            <strong>
                                                @feedback.User.Name
                                            </strong>

                                            <br />

                                            <small class="text-muted">
                                                @feedback.User.Email
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                User not found
                                            </span>
                                        }

                                    </td>


                                    <!-- Rating -->

                                    <td>

                                        <span class="badge bg-warning text-dark">
                                            @feedback.Rating / 5
                                        </span>

                                    </td>


                                    <!-- Comments -->

                                    <td>

                                        @if (!string.IsNullOrEmpty(feedback.Comments))
                                        {
                                            @feedback.Comments
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No comments
                                            </span>
                                        }

                                    </td>


                                    <!-- Date -->

                                    <td>
                                        @feedback.Date.ToString("dd-MM-yyyy")
                                    </td>


                                    <!-- Actions -->

                                    <td>

                                        <div class="btn-group" role="group">
                                            <div class="d-inline-flex gap-1">

                                            <!-- Details -->

                                            <a class="btn btn-sm btn-info text-white"
                                               asp-area="Admin"
                                               asp-controller="Feedbacks"
                                               asp-action="Details"
                                               asp-route-feedbackid="@feedback.FeedbackID">

                                                <i class="bi bi-eye"></i>
                                                Details

                                            </a>


                                            <!-- Delete -->

                                            <a class="btn btn-sm btn-danger"
                                               asp-area="Admin"
                                               asp-controller="Feedbacks"
                                               asp-action="Delete"
                                               asp-route-feedbackid="@feedback.FeedbackID">

                                                <i class="bi bi-trash"></i>
                                                Delete

                                            </a>
                                            </div>
                                         </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- ================= NO FEEDBACK ================= -->

                <div class="text-center py-5">

                    <i class="bi bi-chat-square-text fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No feedback found
                    </h5>

                    <p class="text-muted">
                        There are currently no customer feedback records.
                    </p>

                </div>
            }

        </div>

    </div>

</div>