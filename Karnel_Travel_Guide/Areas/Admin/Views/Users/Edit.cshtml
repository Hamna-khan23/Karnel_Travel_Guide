@model Karnel_Travel_Guide.Models.User

@{
    ViewData["Title"] = "Edit User";
}

<div class="container-fluid px-3 px-lg-4 py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Edit User
            </h2>

            <p class="text-muted mb-0">
                Update user information
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Users"
           asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>
            Back to Users

        </a>

    </div>


    <!-- Edit User Card -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">

            <h5 class="mb-0 fw-bold">
                <i class="bi bi-person-gear me-2"></i>
                Edit User Information
            </h5>

        </div>


        <div class="card-body">

            <!-- Edit Form -->
            <form asp-area="Admin"
                  asp-controller="Users"
                  asp-action="Edit"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- IMPORTANT: userid -->
                <input type="hidden"
                       name="userid"
                       value="@Model.UserID" />


                <div class="row">

                    <!-- Name -->
                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-bold">
                            Name
                        </label>

                        <input type="text"
                               name="Name"
                               value="@Model.Name"
                               class="form-control"
                               placeholder="Enter user name"
                               required />

                    </div>


                    <!-- Email -->
                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-bold">
                            Email
                        </label>

                        <input type="email"
                               name="Email"
                               value="@Model.Email"
                               class="form-control"
                               placeholder="Enter email address"
                               required />

                    </div>


                    <!-- Role -->
                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-bold">
                            Role
                        </label>

                        <select name="Role"
                                class="form-select"
                                required>

                            @if (Model.Role == "Admin")
                            {
                                <option value="User">
                                    User
                                </option>

                                <option value="Admin" selected>
                                    Admin
                                </option>
                            }
                            else
                            {
                                <option value="User" selected>
                                    User
                                </option>

                                <option value="Admin">
                                    Admin
                                </option>
                            }

                        </select>

                    </div>


                    <!-- Phone -->
                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-bold">
                            Phone
                        </label>

                        <input type="text"
                               name="Phone"
                               value="@Model.Phone"
                               class="form-control"
                               placeholder="Enter phone number" />

                    </div>


                    <!-- Created Date -->
                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-bold">
                            Created Date
                        </label>

                        <input type="text"
                               value="@Model.CreatedDate.ToString("dd-MM-yyyy HH:mm")"
                               class="form-control"
                               readonly />

                    </div>


                    <!-- User ID -->
                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-bold">
                            User ID
                        </label>

                        <input type="text"
                               value="@Model.UserID"
                               class="form-control"
                               readonly />

                    </div>

                </div>


                <!-- Buttons -->
                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-primary me-2">

                        <i class="bi bi-check-circle me-1"></i>
                        Save Changes

                    </button>


                    <a asp-area="Admin"
                       asp-controller="Users"
                       asp-action="Index"
                       class="btn btn-secondary">

                        <i class="bi bi-x-circle me-1"></i>
                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>