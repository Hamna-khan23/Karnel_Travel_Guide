@model IEnumerable<Karnel_Travel_Guide.Models.User>

@{
    ViewData["Title"] = "Users";
}

<style>

    /* ==============================
           USERS TABLE
           ============================== */

    .users-table {
        width: 100%;
        margin-bottom: 0;
        font-size: 13px;
    }

        .users-table th,
        .users-table td {
            padding: 11px 10px;
            vertical-align: middle;
        }

        .users-table th {
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
            text-transform: uppercase;
        }

        /* Center table headings */
        .users-table thead th {
            text-align: center;
        }

        /* Center table data */
        .users-table tbody td {
            text-align: center;
        }


    /* ==============================
           NAME
           ============================== */

    .user-name {
        font-weight: 600;
        white-space: nowrap;
    }


    /* ==============================
           EMAIL
           ============================== */

    .user-email {
        white-space: nowrap;
    }


    /* ==============================
           ROLE
           ============================== */

    .user-role {
        white-space: nowrap;
    }


    /* ==============================
           PHONE
           ============================== */

    .user-phone {
        white-space: nowrap;
    }


    /* ==============================
           CREATED DATE
           ============================== */

    .user-date {
        white-space: nowrap;
    }


    /* ==============================
           ACTIONS COLUMN
           ============================== */

    .user-actions {
        min-width: 300px !important;
        width: 300px !important;
        text-align: center !important;
        white-space: nowrap !important;
    }


    /* ==============================
           ACTION BUTTON WRAPPER
           ============================== */

    .user-actions-wrapper {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 8px !important;
        flex-wrap: nowrap !important;
        white-space: nowrap !important;
    }


        /* ==============================
           ACTION BUTTONS
           ============================== */

        .user-actions-wrapper a {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 5px !important;
            width: auto !important;
            min-width: 0 !important;
            padding: 7px 12px !important;
            font-size: 12px !important;
            font-weight: 600 !important;
            white-space: nowrap !important;
            text-decoration: none !important;
            border-radius: 6px !important;
        }


            .user-actions-wrapper a i {
                display: inline-block !important;
                font-size: 14px !important;
                line-height: 1 !important;
            }


    /* ==============================
           DETAILS
           ============================== */

    .user-details-btn {
        background-color: #0dcaf0 !important;
        border-color: #0dcaf0 !important;
        color: #ffffff !important;
    }

        .user-details-btn:hover {
            background-color: #0aa2c0 !important;
            border-color: #0aa2c0 !important;
            color: #ffffff !important;
        }


    /* ==============================
           EDIT
           ============================== */

    .user-edit-btn {
        background-color: #ffc107 !important;
        border-color: #ffc107 !important;
        color: #000000 !important;
    }

        .user-edit-btn:hover {
            background-color: #e0a800 !important;
            border-color: #e0a800 !important;
            color: #000000 !important;
        }


    /* ==============================
           DELETE
           ============================== */

    .user-delete-btn {
        background-color: #dc3545 !important;
        border-color: #dc3545 !important;
        color: #ffffff !important;
    }

        .user-delete-btn:hover {
            background-color: #bb2d3b !important;
            border-color: #bb2d3b !important;
            color: #ffffff !important;
        }


    /* ==============================
           CARD
           ============================== */

    .users-card {
        width: 100%;
        border: 0;
        border-radius: 8px;
    }


    /* ==============================
           TABLE SCROLL
           ============================== */

    .users-table-container {
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
    }


    /* ==============================
           MOBILE
           ============================== */

    @@media (max-width: 768px) {

        .user-actions {
            min-width: 280px !important;
            width: 280px !important;
        }

        .user-actions-wrapper {
            gap: 5px !important;
        }

            .user-actions-wrapper a {
                font-size: 11px !important;
                padding: 6px 9px !important;
            }
    }

</style>


<div class="container-fluid px-3 px-lg-4 py-4">

    <!-- ==============================
         PAGE HEADER
         ============================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Users
            </h2>

            <p class="text-muted mb-0">
                Manage registered users
            </p>

        </div>

    </div>


    <!-- ==============================
         USERS CARD
         ============================== -->

    <div class="card shadow-sm users-card">

        <div class="card-header bg-white py-3">

            <h5 class="mb-0 fw-bold">
                All Users
            </h5>

        </div>


        <div class="card-body p-3">

            @if (Model != null && Model.Any())
            {

                <div class="users-table-container">

                    <table class="table table-hover align-middle users-table">

                        <thead>

                            <tr>

                                <th>
                                    ID
                                </th>

                                <th>
                                    Name
                                </th>

                                <th>
                                    Email
                                </th>

                                <th>
                                    Role
                                </th>

                                <th>
                                    Phone
                                </th>

                                <th>
                                    Created Date
                                </th>

                                <th class="user-actions">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var user in Model)
                            {
                                <tr>

                                    <!-- ID -->

                                    <td>
                                        <strong>
                                            @user.UserID
                                        </strong>
                                    </td>


                                    <!-- NAME -->

                                    <td class="user-name">

                                        @user.Name

                                    </td>


                                    <!-- EMAIL -->

                                    <td class="user-email">

                                        @user.Email

                                    </td>


                                    <!-- ROLE -->

                                    <td class="user-role">

                                        @if (user.Role == "Admin")
                                        {
                                            <span class="badge bg-danger">
                                                Admin
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">
                                                User
                                            </span>
                                        }

                                    </td>


                                    <!-- PHONE -->

                                    <td class="user-phone">

                                        @(string.IsNullOrEmpty(user.Phone)
                                            ? "N/A"
                                            : user.Phone)

                                    </td>


                                    <!-- CREATED DATE -->

                                    <td class="user-date">

                                        @user.CreatedDate.ToString("dd-MM-yyyy")

                                    </td>


                                    <!-- ==============================
                                         ACTIONS
                                         ============================== -->

                                    <td class="user-actions">

                                        <div class="user-actions-wrapper">


                                            <!-- DETAILS -->

                                            <a asp-area="Admin"
                                               asp-controller="Users"
                                               asp-action="Details"
                                               asp-route-userid="@user.UserID"
                                               class="btn user-details-btn"
                                               title="View Details">

                                                <i class="bi bi-eye"></i>

                                                <span>
                                                    Details
                                                </span>

                                            </a>


                                            <!-- EDIT -->

                                            <a asp-area="Admin"
                                               asp-controller="Users"
                                               asp-action="Edit"
                                               asp-route-userid="@user.UserID"
                                               class="btn user-edit-btn"
                                               title="Edit User">

                                                <i class="bi bi-pencil"></i>

                                                <span>
                                                    Edit
                                                </span>

                                            </a>


                                            <!-- DELETE -->

                                            <a asp-area="Admin"
                                               asp-controller="Users"
                                               asp-action="Delete"
                                               asp-route-userid="@user.UserID"
                                               class="btn user-delete-btn"
                                               title="Delete User">

                                                <i class="bi bi-trash"></i>

                                                <span>
                                                    Delete
                                                </span>

                                            </a>


                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            }
            else
            {

                <!-- NO USERS -->

                <div class="text-center py-5">

                    <i class="bi bi-people fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No users found
                    </h5>

                    <p class="text-muted">
                        There are currently no registered users.
                    </p>

                </div>

            }

        </div>

    </div>

</div>