
@model IEnumerable<Karnel_Travel_Guide.Models.TouristSpot>

@{
    ViewData["Title"] = "Tourist Spots";
}

<style>
    .tourist-table {
        width: 100%;
        min-width: 1050px;
        margin-bottom: 0;
        font-size: 13px;
        border-collapse: collapse;
    }

        .tourist-table th,
        .tourist-table td {
            padding: 11px 8px;
            vertical-align: middle;
            text-align: center;
            border-bottom: 1px solid #dee2e6;
        }

        .tourist-table th {
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
            text-transform: uppercase;
        }

        .tourist-table td {
            white-space: normal;
            overflow-wrap: break-word;
        }

    .tourist-id {
        min-width: 60px;
        width: 60px;
        white-space: nowrap !important;
    }

    .tourist-name {
        min-width: 140px;
        font-weight: 600;
    }

    .tourist-description {
        min-width: 220px;
        max-width: 260px;
    }

    .tourist-city {
        min-width: 100px;
        white-space: nowrap !important;
    }

    .tourist-image {
        min-width: 130px;
        max-width: 160px;
    }

    .tourist-category {
        min-width: 110px;
        white-space: nowrap !important;
    }

    .tourist-packages {
        min-width: 90px;
        white-space: nowrap !important;
    }

    .tourist-actions {
        min-width: 270px !important;
        width: 270px !important;
        white-space: nowrap !important;
        text-align: center !important;
    }

    .tourist-actions-wrapper {
        display: flex !important;
        justify-content: center !important;
        align-items: center !important;
        gap: 7px !important;
        flex-wrap: nowrap !important;
        white-space: nowrap !important;
    }

        .tourist-actions-wrapper a {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            flex-direction: row !important;
            gap: 5px !important;
            height: 38px !important;
            padding: 7px 12px !important;
            margin: 0 !important;
            font-size: 12px !important;
            font-weight: 600 !important;
            white-space: nowrap !important;
            text-decoration: none !important;
            border-radius: 6px !important;
            width: auto !important;
            min-width: auto !important;
            overflow: visible !important;
        }

            .tourist-actions-wrapper a i {
                display: inline-block !important;
                visibility: visible !important;
                width: auto !important;
                height: auto !important;
                font-size: 14px !important;
                line-height: 1 !important;
                flex-shrink: 0 !important;
            }

            .tourist-actions-wrapper a span {
                display: inline-block !important;
                visibility: visible !important;
                width: auto !important;
                height: auto !important;
                opacity: 1 !important;
                position: static !important;
                font-size: 12px !important;
                line-height: 1 !important;
                white-space: nowrap !important;
                overflow: visible !important;
                clip: auto !important;
                flex-shrink: 0 !important;
            }

    .tourist-details-btn {
        background-color: #0dcaf0 !important;
        border: 1px solid #0dcaf0 !important;
        color: #ffffff !important;
        min-width: 82px !important;
    }

        .tourist-details-btn:hover {
            background-color: #0aa2c0 !important;
            border-color: #0aa2c0 !important;
            color: #ffffff !important;
        }

    .tourist-edit-btn {
        background-color: #ffc107 !important;
        border: 1px solid #ffc107 !important;
        color: #000000 !important;
        min-width: 65px !important;
    }

        .tourist-edit-btn:hover {
            background-color: #e0a800 !important;
            border-color: #e0a800 !important;
            color: #000000 !important;
        }

    .tourist-delete-btn {
        background-color: #dc3545 !important;
        border: 1px solid #dc3545 !important;
        color: #ffffff !important;
        min-width: 78px !important;
    }

        .tourist-delete-btn:hover {
            background-color: #bb2d3b !important;
            border-color: #bb2d3b !important;
            color: #ffffff !important;
        }

    .create-tourist-btn {
        background-color: #198754 !important;
        border: 1px solid #198754 !important;
        color: #ffffff !important;
        font-weight: 600;
        padding: 8px 16px;
        border-radius: 6px;
    }

        .create-tourist-btn:hover {
            background-color: #157347 !important;
            border-color: #146c43 !important;
            color: #ffffff !important;
        }

    .tourist-card {
        width: 100%;
        border: 0;
        border-radius: 8px;
    }

    .tourist-table-container {
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
    }

        .tourist-table-container::-webkit-scrollbar {
            height: 8px;
        }

        .tourist-table-container::-webkit-scrollbar-thumb {
            background: #b8b8b8;
            border-radius: 10px;
        }

        .tourist-table-container::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

    @@media (max-width: 768px) {
        .tourist-actions {
            min-width: 240px !important;
            width: 240px !important;
        }

        .tourist-actions-wrapper {
            gap: 5px !important;
        }

            .tourist-actions-wrapper a {
                height: 36px !important;
                padding: 6px 9px !important;
                font-size: 11px !important;
            }

                .tourist-actions-wrapper a span {
                    display: inline-block !important;
                    font-size: 11px !important;
                }

                .tourist-actions-wrapper a i {
                    font-size: 13px !important;
                }
    }
</style>

<div class="container-fluid px-3 px-lg-4 py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                Tourist Spots
            </h2>
            <p class="text-muted mb-0">
                Manage tourist spots and destinations
            </p>
        </div>

        <div>
            <a asp-area="Admin"
               asp-controller="TouristSpots"
               asp-action="Create"
               class="btn create-tourist-btn">
                <i class="bi bi-plus-circle me-1"></i>
                Create Tourist Spot
            </a>
        </div>
    </div>

    <!-- TABLE CARD -->
    <div class="card shadow-sm tourist-card">
        <div class="card-body p-3">
            <div class="tourist-table-container">
                <table class="table table-hover align-middle tourist-table">
                    <thead>
                        <tr>
                            <th class="tourist-id">ID</th>
                            <th class="tourist-name">Name</th>
                            <th class="tourist-description">Description</th>
                            <th class="tourist-city">City</th>
                            <th class="tourist-image">Price </th>
                            <th class="tourist-image">Image</th>
                            <th class="tourist-category">Category</th>
                            <th class="tourist-packages">Packages</th>
                            <th class="tourist-actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="tourist-id">
                                    <strong>@item.SpotID</strong>
                                </td>

                                <td class="tourist-name">
                                    @item.Name
                                </td>

                                <td class="tourist-description">
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        @item.Description
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>

                                <td class="tourist-city">
                                    @item.City
                                </td>
                                <td class="tourist-city">
                                    @item.PricePerNight.ToString("N2")
                                </td>

                                <td class="tourist-image">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        var images = item.ImageUrl.Split(',', StringSplitOptions.RemoveEmptyEntries);
                                        var firstImg = images.FirstOrDefault()?.Trim();
                                        <div class="d-inline-flex align-items-center gap-1">
                                            <img src="@firstImg" alt="@item.Name" class="img-thumbnail" style="max-height: 50px; max-width: 70px; object-fit: cover;" />
                                            @if (images.Length > 1)
                                            {
                                                <span class="badge bg-secondary" title="@images.Length images total">+@(images.Length - 1)</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>

                                <td class="tourist-category">
                                    @if (!string.IsNullOrEmpty(item.Category))
                                    {
                                        <span class="badge bg-primary">@item.Category</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>

                                <td class="tourist-packages">
                                    @if (item.Packages != null && item.Packages.Any())
                                    {
                                        <span class="badge bg-success">@item.Packages.Count</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>

                                <td class="tourist-actions">
                                    <div class="tourist-actions-wrapper">
                                        <a asp-area="Admin"
                                           asp-controller="TouristSpots"
                                           asp-action="Details"
                                           asp-route-id="@item.SpotID"
                                           class="btn tourist-details-btn"
                                           title="View Details">
                                            <i class="bi bi-eye"></i>
                                            <span>Details</span>
                                        </a>

                                        <a asp-area="Admin"
                                           asp-controller="TouristSpots"
                                           asp-action="Edit"
                                           asp-route-id="@item.SpotID"
                                           class="btn tourist-edit-btn"
                                           title="Edit Tourist Spot">
                                            <i class="bi bi-pencil"></i>
                                            <span>Edit</span>
                                        </a>

                                        <a asp-area="Admin"
                                           asp-controller="TouristSpots"
                                           asp-action="Delete"
                                           asp-route-id="@item.SpotID"
                                           class="btn tourist-delete-btn"
                                           title="Delete Tourist Spot">
                                            <i class="bi bi-trash"></i>
                                            <span>Delete</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>