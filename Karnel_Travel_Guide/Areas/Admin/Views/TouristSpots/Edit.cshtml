
@model Karnel_Travel_Guide.Models.TouristSpot

@{
    ViewData["Title"] = "Edit Tourist Spot";
}

<div class="container-fluid px-4 px-lg-5 py-4">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                Edit Tourist Spot
            </h2>
            <p class="text-muted mb-0">
                Update tourist spot information
            </p>
        </div>

        <div>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back to List
            </a>
        </div>
    </div>

    <!-- Edit Card -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">
                Tourist Spot Information
            </h5>
        </div>

        <div class="card-body p-4">
            <form asp-action="Edit"
                  asp-route-id="@Model.SpotID"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden" name="id" value="@Model.SpotID" />
                <input type="hidden" asp-for="SpotID" />
                <input type="hidden" asp-for="ImageUrl" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-4">
                    <!-- Spot ID -->
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">
                            Spot ID
                        </label>
                        <input type="text" class="form-control bg-light" value="@Model.SpotID" readonly />
                    </div>

                    <!-- Name -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <!-- City -->
                    <div class="col-12 col-md-6">
                        <label asp-for="City" class="form-label fw-semibold"></label>
                        <input asp-for="City" class="form-control" />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>

                    <!-- Category -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Category" class="form-label fw-semibold"></label>
                        <input asp-for="Category" class="form-control" />
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="PricePerNight" class="form-label fw-semibold">Price</label>
                        <input asp-for="PricePerNight" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="PricePerNight" class="text-danger"></span>
                    </div>

                    <!-- Multiple Image Upload & Management -->
                    <div class="col-12">
                        <label class="form-label fw-semibold">Current Images</label>
                        <div class="mb-3 d-flex flex-wrap gap-3">
                            @if (!string.IsNullOrEmpty(Model?.ImageUrl))
                            {
                                var images = Model.ImageUrl.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries);
                                foreach (var img in images)
                                {
                                    var trimmedImg = img.Trim();
                                    <div class="card p-1 text-center shadow-sm" style="width: 110px;">
                                        <img src="@Url.Content(trimmedImg)" alt="@Model.Name" class="rounded" style="height: 80px; width: 100%; object-fit: cover;" />
                                        <div class="form-check mt-1 d-flex justify-content-center align-items-center gap-1">
                                            <input type="checkbox" name="removeImages" value="@trimmedImg" class="form-check-input" id="chk_@trimmedImg.GetHashCode()" />
                                            <label class="form-check-label text-danger small fw-semibold" for="chk_@trimmedImg.GetHashCode()">Remove</label>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="text-muted d-block">No Images Uploaded</span>
                            }
                        </div>

                        <label class="form-label fw-semibold">Add More Images</label>
                        <input type="file" name="imageFiles" class="form-control" accept="image/*" multiple />
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    </div>

                    <!-- Description -->
                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-1"></i>
                        Save Changes
                    </button>

                    <a asp-action="Details"
                       asp-route-id="@Model.SpotID"
                       class="btn btn-info text-white">
                        <i class="bi bi-eye me-1"></i>
                        Details
                    </a>

                    <a asp-action="Index" class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}