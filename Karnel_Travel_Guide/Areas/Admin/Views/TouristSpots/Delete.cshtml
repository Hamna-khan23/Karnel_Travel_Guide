
@model Karnel_Travel_Guide.Models.TouristSpot

@{
    ViewData["Title"] = "Delete Tourist Spot";
}

<div class="container-fluid px-4 px-lg-5 py-4">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                Delete Tourist Spot
            </h2>
            <p class="text-muted mb-0">
                Confirm deletion of this tourist spot
            </p>
        </div>

        <div>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back to List
            </a>
        </div>
    </div>

    <!-- Delete Card -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-danger text-white py-3">
            <h5 class="fw-bold mb-0">
                Confirm Delete
            </h5>
        </div>

        <div class="card-body p-4">
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle me-2"></i>
                Are you sure you want to delete this tourist spot?
            </div>

            <div class="row g-4">
                <!-- Spot ID -->
                <div class="col-12 col-md-6">
                    <div class="border rounded p-3">
                        <small class="text-muted d-block mb-1">Spot ID</small>
                        <strong>@Model.SpotID</strong>
                    </div>
                </div>

                <!-- Name -->
                <div class="col-12 col-md-6">
                    <div class="border rounded p-3">
                        <small class="text-muted d-block mb-1">Name</small>
                        <strong>@Model.Name</strong>
                    </div>
                </div>

                <!-- City -->
                <div class="col-12 col-md-6">
                    <div class="border rounded p-3">
                        <small class="text-muted d-block mb-1">City</small>
                        <span>@Model.City</span>
                    </div>
                </div>

                <!-- Category -->
                <div class="col-12 col-md-6">
                    <div class="border rounded p-3">
                        <small class="text-muted d-block mb-1">Category</small>
                        <span>@Model.Category</span>
                    </div>
                </div>
                <!-- Price -->
                <div class="col-12 col-md-6">

                    <div class="border rounded p-3 h-100">

                        <small class="text-muted d-block mb-1">
                            Price 
                        </small>

                        <strong>
                            @Model.PricePerNight
                        </strong>

                    </div>

                </div>

                <!-- Image Preview (Multiple Images Support) -->
                <div class="col-12">
                    <div class="border rounded p-3">
                        <small class="text-muted d-block mb-1">Images</small>
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            var images = Model.ImageUrl.Split(',', StringSplitOptions.RemoveEmptyEntries);
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var img in images)
                                {
                                    <img src="@img.Trim()" alt="@Model.Name" class="img-thumbnail" style="max-height: 150px;" />
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">N/A</span>
                        }
                    </div>
                </div>

                <!-- Description -->
                <div class="col-12">
                    <div class="border rounded p-3">
                        <small class="text-muted d-block mb-1">Description</small>
                        <span>@Model.Description</span>
                    </div>
                </div>
            </div>

            <!-- Delete Form -->
            <form asp-action="Delete" method="post" class="mt-4">
                @Html.AntiForgeryToken()

                <input type="hidden" name="id" value="@Model.SpotID" />

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>
                        Delete Tourist Spot
                    </button>

                    <a asp-action="Details" asp-route-id="@Model.SpotID" class="btn btn-info text-white">
                        <i class="bi bi-eye me-1"></i>
                        Details
                    </a>

                    <a asp-action="Index" class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>